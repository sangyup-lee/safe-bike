# All providers always use real data. No demo fallback is available.
# The documented Seoul endpoint uses HTTP. Explicit opt-in is required for live stations.
SEOUL_ALLOW_HTTP=false

# SERVER ONLY: never prefix these with NEXT_PUBLIC_.
SEOUL_API_KEY=
DATA_GO_KR_API_KEY=
KAKAO_REST_API_KEY=

# PUBLIC: Kakao Maps JavaScript SDK requires a browser-visible JavaScript key.
# Restrict the allowed JavaScript SDK domains in Kakao Developers.
NEXT_PUBLIC_KAKAO_JS_KEY=
